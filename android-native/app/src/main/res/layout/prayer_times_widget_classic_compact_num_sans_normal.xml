<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_times_root" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_vertical" android:background="@android:color/transparent">
  <LinearLayout android:id="@+id/widget_times_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="2dp" android:background="@android:color/transparent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layoutDirection="rtl" android:gravity="center_vertical" android:paddingTop="2dp" android:paddingBottom="2dp" android:paddingLeft="5dp" android:paddingRight="5dp" android:background="@drawable/aoqat_widget_countdown_outline">
      <TextView android:id="@+id/widget_times_next_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="start|center_vertical" android:text="باقي على صلاة الفجر" android:textSize="13sp" android:textStyle="bold" android:textColor="#FFFFFFFF" android:maxLines="1" />
      <Chronometer android:id="@+id/widget_times_next_counter" android:layout_width="wrap_content" android:layout_marginStart="5dp" android:layout_height="wrap_content" android:gravity="center" android:format="%s" android:textColor="#FFDAEEAF" android:textSize="15sp" android:includeFontPadding="false"  android:fontFamily="sans-serif" android:textStyle="normal" />
    </LinearLayout>
    <TextView android:id="@+id/widget_times_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="مواقيت الصلاة اليوم" android:gravity="center" android:paddingBottom="0dp" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" />
    <LinearLayout android:id="@+id/widget_times_row_fajr" android:layout_width="wrap_content" android:layout_gravity="center_horizontal" android:layout_height="wrap_content" android:minHeight="17dp" android:orientation="horizontal" android:layoutDirection="rtl" android:gravity="center_vertical" android:paddingLeft="4dp" android:paddingRight="4dp">
      <TextView android:id="@+id/widget_times_fajr" android:layout_width="wrap_content" android:minWidth="66dp" android:layout_height="wrap_content" android:gravity="start|center_vertical" android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFFFF" android:includeFontPadding="false"/>
      <TextView android:id="@+id/widget_time_clock_fajr" android:layout_width="wrap_content" android:layout_marginStart="9dp" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold" android:gravity="end|center_vertical" android:textColor="#FFFFFFFF" android:includeFontPadding="false"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_times_row_sunrise" android:layout_width="wrap_content" android:layout_gravity="center_horizontal" android:layout_height="wrap_content" android:minHeight="17dp" android:orientation="horizontal" android:layoutDirection="rtl" android:gravity="center_vertical" android:paddingLeft="4dp" android:paddingRight="4dp">
      <TextView android:id="@+id/widget_times_sunrise" android:layout_width="wrap_content" android:minWidth="66dp" android:layout_height="wrap_content" android:gravity="start|center_vertical" android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFFFF" android:includeFontPadding="false"/>
      <TextView android:id="@+id/widget_time_clock_sunrise" android:layout_width="wrap_content" android:layout_marginStart="9dp" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold" android:gravity="end|center_vertical" android:textColor="#FFFFFFFF" android:includeFontPadding="false"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_times_row_dhuhr" android:layout_width="wrap_content" android:layout_gravity="center_horizontal" android:layout_height="wrap_content" android:minHeight="17dp" android:orientation="horizontal" android:layoutDirection="rtl" android:gravity="center_vertical" android:paddingLeft="4dp" android:paddingRight="4dp">
      <TextView android:id="@+id/widget_times_dhuhr" android:layout_width="wrap_content" android:minWidth="66dp" android:layout_height="wrap_content" android:gravity="start|center_vertical" android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFFFF" android:includeFontPadding="false"/>
      <TextView android:id="@+id/widget_time_clock_dhuhr" android:layout_width="wrap_content" android:layout_marginStart="9dp" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold" android:gravity="end|center_vertical" android:textColor="#FFFFFFFF" android:includeFontPadding="false"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_times_row_asr" android:layout_width="wrap_content" android:layout_gravity="center_horizontal" android:layout_height="wrap_content" android:minHeight="17dp" android:orientation="horizontal" android:layoutDirection="rtl" android:gravity="center_vertical" android:paddingLeft="4dp" android:paddingRight="4dp">
      <TextView android:id="@+id/widget_times_asr" android:layout_width="wrap_content" android:minWidth="66dp" android:layout_height="wrap_content" android:gravity="start|center_vertical" android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFFFF" android:includeFontPadding="false"/>
      <TextView android:id="@+id/widget_time_clock_asr" android:layout_width="wrap_content" android:layout_marginStart="9dp" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold" android:gravity="end|center_vertical" android:textColor="#FFFFFFFF" android:includeFontPadding="false"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_times_row_maghrib" android:layout_width="wrap_content" android:layout_gravity="center_horizontal" android:layout_height="wrap_content" android:minHeight="17dp" android:orientation="horizontal" android:layoutDirection="rtl" android:gravity="center_vertical" android:paddingLeft="4dp" android:paddingRight="4dp">
      <TextView android:id="@+id/widget_times_maghrib" android:layout_width="wrap_content" android:minWidth="66dp" android:layout_height="wrap_content" android:gravity="start|center_vertical" android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFFFF" android:includeFontPadding="false"/>
      <TextView android:id="@+id/widget_time_clock_maghrib" android:layout_width="wrap_content" android:layout_marginStart="9dp" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold" android:gravity="end|center_vertical" android:textColor="#FFFFFFFF" android:includeFontPadding="false"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_times_row_isha" android:layout_width="wrap_content" android:layout_gravity="center_horizontal" android:layout_height="wrap_content" android:minHeight="17dp" android:orientation="horizontal" android:layoutDirection="rtl" android:gravity="center_vertical" android:paddingLeft="4dp" android:paddingRight="4dp">
      <TextView android:id="@+id/widget_times_isha" android:layout_width="wrap_content" android:minWidth="66dp" android:layout_height="wrap_content" android:gravity="start|center_vertical" android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFFFF" android:includeFontPadding="false"/>
      <TextView android:id="@+id/widget_time_clock_isha" android:layout_width="wrap_content" android:layout_marginStart="9dp" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold" android:gravity="end|center_vertical" android:textColor="#FFFFFFFF" android:includeFontPadding="false"/>
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
