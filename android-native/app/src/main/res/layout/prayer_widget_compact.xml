<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/prayer_widget_root"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" 
    android:gravity="center_vertical"    
    android:background="@android:color/transparent">
    <LinearLayout android:id="@+id/widget_next_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layoutDirection="rtl" android:gravity="center_vertical" android:paddingLeft="6dp" android:paddingRight="6dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:background="@android:color/transparent">

    <TextView android:id="@+id/widget_prayer"
        android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:gravity="center_vertical|start"
        android:maxLines="2" android:ellipsize="end"
        android:textColor="#FFFFFFFF" android:textSize="19sp" android:textStyle="bold"
        android:shadowColor="#C0000000" android:shadowRadius="3"
        android:text="باقي على صلاة المغرب" />
    <Chronometer android:id="@+id/widget_counter"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:gravity="center" android:layout_marginStart="7dp"
        android:textColor="#FFFFFFFF" android:textSize="24sp" android:textStyle="bold"
        android:shadowColor="#C0000000" android:shadowRadius="3"
        android:format="%s" />
    <TextView android:id="@+id/widget_date"
        android:layout_width="0dp" android:layout_height="0dp"
        android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
