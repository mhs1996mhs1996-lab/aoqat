<?xml version="1.0" encoding="utf-8"?>
<!-- Owner pilot: Android/OEM owns the upper waiting symbol in a fixed icon lane.
     Align the active secondary symbol vertically below that lane without
     altering the clock widths, labels, timing, or secondary row visibility. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layoutDirection="rtl">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="30dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="1dp"
        android:paddingBottom="1dp">
        <ImageView
            android:id="@+id/lock_prayer_state_icon"
            android:layout_width="30dp"
            android:layout_height="26dp"
            android:layout_marginEnd="6dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="رمز ثابت للصلاة القادمة"/>
        <TextView
            android:id="@+id/lock_prayer_title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="right|center_vertical"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:shadowColor="#CC000000"
            android:shadowRadius="2"
            android:shadowDy="1"
            android:singleLine="true"
            android:ellipsize="end"/>
        <Chronometer
            android:id="@+id/lock_prayer_clock"
            android:layout_width="105dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:gravity="left|center_vertical"
            android:layoutDirection="ltr"
            android:textSize="17sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:shadowColor="#CC000000"
            android:shadowRadius="2"
            android:shadowDy="1"/>
        <TextView
            android:id="@+id/lock_prayer_fallback"
            android:layout_width="105dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:gravity="left|center_vertical"
            android:layoutDirection="ltr"
            android:textSize="17sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:shadowColor="#CC000000"
            android:shadowRadius="2"
            android:shadowDy="1"/>
    </LinearLayout>
    <!-- This whole row disappears together with its dynamic counter/icon. -->
    <LinearLayout
        android:id="@+id/lock_iqama_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:minHeight="30dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/lock_iqama_state_icon"
            android:layout_width="30dp"
            android:layout_height="26dp"
            android:translationX="42dp"
            android:layout_marginEnd="6dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="رمز متغير للإقامة أو الجمعة"/>
        <TextView
            android:id="@+id/lock_iqama_title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="right|center_vertical"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:shadowColor="#CC000000"
            android:shadowRadius="2"
            android:shadowDy="1"
            android:singleLine="true"
            android:ellipsize="end"/>
        <Chronometer
            android:id="@+id/lock_iqama_clock"
            android:layout_width="105dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:gravity="left|center_vertical"
            android:layoutDirection="ltr"
            android:textSize="17sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:shadowColor="#CC000000"
            android:shadowRadius="2"
            android:shadowDy="1"/>
    </LinearLayout>
</LinearLayout>
