<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_times_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center"
     android:background="@android:color/transparent">
    <LinearLayout android:id="@+id/widget_times_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"  android:gravity="center_vertical" android:padding="12dp" android:background="@android:color/transparent">

    <TextView android:id="@+id/widget_times_header" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center" android:text="مواقيت الصلاة اليوم"
        android:textColor="#FFFFFFFF" android:textSize="19sp" android:textStyle="bold"
        android:shadowColor="#C0000000" android:shadowRadius="3" android:shadowDx="1" android:shadowDy="1"
        android:paddingBottom="5dp" />
    <TextView android:id="@+id/widget_times_fajr" style="@style/WidgetPrayerLine" />
    <TextView android:id="@+id/widget_times_dhuhr" style="@style/WidgetPrayerLine" />
    <TextView android:id="@+id/widget_times_asr" style="@style/WidgetPrayerLine" />
    <TextView android:id="@+id/widget_times_maghrib" style="@style/WidgetPrayerLine" />
    <TextView android:id="@+id/widget_times_isha" style="@style/WidgetPrayerLine" />
    </LinearLayout>
</LinearLayout>
