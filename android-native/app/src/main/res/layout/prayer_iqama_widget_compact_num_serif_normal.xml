<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_iqama_root"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center_vertical"
        android:background="@android:color/transparent">
    <LinearLayout android:id="@+id/widget_iqama_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"  android:gravity="center_vertical" android:paddingLeft="6dp" android:paddingRight="6dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:background="@android:color/transparent">

    <TextView android:id="@+id/widget_iqama_prayer"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FFFFFFFF" android:textSize="23sp" android:textStyle="bold" android:includeFontPadding="false"
        android:gravity="center" android:paddingBottom="1dp" />
    <LinearLayout android:layout_width="wrap_content" android:layout_gravity="center_horizontal" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layoutDirection="rtl" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_iqama_before_title"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="باقي على الإقامة" android:textColor="#FFFFFFFF"
            android:textSize="16sp" android:textStyle="bold" android:includeFontPadding="false" android:gravity="start|center_vertical"
            android:maxLines="2"/>
        <Chronometer android:id="@+id/widget_iqama_before_counter"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:textColor="#FFFFFFFF"
            android:textSize="21sp" android:includeFontPadding="false" android:format="%s" android:fontFamily="serif" android:textStyle="normal" />
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_gravity="center_horizontal" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layoutDirection="rtl" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_iqama_elapsed_title"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="مضى على الإقامة" android:textColor="#FFFFFFFF"
            android:textSize="16sp" android:textStyle="bold" android:includeFontPadding="false" android:gravity="start|center_vertical"
            android:maxLines="2"/>
        <Chronometer android:id="@+id/widget_iqama_elapsed_counter"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:textColor="#FFFFFFFF"
            android:textSize="21sp" android:includeFontPadding="false" android:format="%s" android:fontFamily="serif" android:textStyle="normal" />
    </LinearLayout>
    <TextView android:id="@+id/widget_iqama_state"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"
        android:textColor="#FFFFFFFF" android:textSize="11sp" android:textStyle="bold" android:includeFontPadding="false"
        android:gravity="center" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
