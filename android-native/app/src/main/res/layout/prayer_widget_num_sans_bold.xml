<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/prayer_widget_root" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="7dp" android:background="@android:color/transparent">
<TextView android:id="@+id/widget_prayer" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#FFFFFFFF" android:textSize="23sp" android:textStyle="bold" android:shadowColor="#C0000000" android:shadowRadius="3" android:shadowDx="1" android:shadowDy="1" android:text="الصلاة القادمة" />
<Chronometer android:id="@+id/widget_counter" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#FFFFFFFF" android:textSize="32sp" android:shadowColor="#C0000000" android:shadowRadius="3" android:shadowDx="1" android:shadowDy="1" android:format="%s" android:fontFamily="sans-serif" android:textStyle="bold" />
<TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" android:shadowColor="#C0000000" android:shadowRadius="3" android:shadowDx="1" android:shadowDy="1" />
</LinearLayout>
