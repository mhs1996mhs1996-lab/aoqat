<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Model 1: amber rounded square, white hourglass.
         This is custom notification content, NOT a large/system icon. -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="13dp"/>
            <gradient
                android:angle="270"
                android:startColor="#FFFFBF37"
                android:centerColor="#FFFFA313"
                android:endColor="#FFFF8000"/>
            <stroke android:width="1dp" android:color="#FFFFBC57"/>
        </shape>
    </item>
    <item android:left="9dp" android:top="9dp"
          android:right="9dp" android:bottom="9dp"
          android:drawable="@drawable/aoqat_notification_hourglass"/>
</layer-list>
